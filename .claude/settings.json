{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./data/**)", "Read(./.e2e-data/**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
